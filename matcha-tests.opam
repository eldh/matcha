# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Test suite for matcha (not published)"
description:
  "The matcha test suite, kept in its own package so that it never runs as part of installing matcha. Not published to the opam repository."
maintainer: ["Andreas Eldh"]
authors: ["Andreas Eldh"]
license: "MIT"
homepage: "https://github.com/eldh/matcha"
bug-reports: "https://github.com/eldh/matcha/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "5.3.0"}
  "reason" {>= "3.12.0"}
  "matcha"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/eldh/matcha.git"
